# Lives on the VPS as /opt/smart-door-prod/.env.prod (never committed).

POSTGRES_DB=smartdoor_prod
POSTGRES_USER=smartdoor
POSTGRES_PASSWORD=change-me

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=smartdoor_prod;Username=smartdoor;Password=change-me
Redis__ConnectionString=redis:6379
ASPNETCORE_ENVIRONMENT=Production

# The web app's address — allowed to call the API.
Cors__AllowedOrigins__0=https://utils.czeros.tech

# Phone fingerprint unlock: the web app's host name (no https://, no port)
# and its full address.
WebAuthn__RpId=utils.czeros.tech
WebAuthn__Origins__0=https://utils.czeros.tech

# Long random string (e.g. `openssl rand -base64 48`) — signs login JWTs.
Jwt__Key=change-me-to-a-long-random-string

# Shared secret the door controller sends as X-Device-Key.
# Must equal DEVICE_API_KEY in firmware/door-controller/include/secrets.h.
Device__ApiKey=change-me-to-a-long-random-string

# Admin logins to create on startup (skipped if the username exists).
SeedUsers__0__Username=change-me
SeedUsers__0__Password=change-me

# Always-on door link (broker in the same compose file). The broker's
# mosquitto/passwd must have this backend user, plus user "door" whose
# password is Device__ApiKey. Leave Mqtt__Host empty to run REST-only.
Mqtt__Host=mosquitto
Mqtt__Port=1883
Mqtt__Username=backend
Mqtt__Password=change-me-to-a-long-random-string
