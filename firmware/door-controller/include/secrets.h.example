#pragma once

// Copy to secrets.h (gitignored) and fill in.

#define WIFI_SSID "Your-WiFi-SSID"
#define WIFI_PASSWORD "your-wifi-password"

// Backend base URL including the /api prefix. Deployed: prod
// "https://utils-api.czeros.tech/api", dev "https://utils-api-dev.czeros.tech/api".
// For local dev this is the PC
// running `dotnet run` (port 5125), on the same WiFi as the door.
#define API_BASE_URL "http://192.168.1.100:5125/api"

// Must equal the backend's Device:ApiKey setting.
#define DEVICE_API_KEY "change-me"

// Optional, for an https:// API_BASE_URL: the server's root CA in PEM form.
// Without it HTTPS still encrypts, but doesn't verify the server.
// #define API_ROOT_CA "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

// MQTT broker (always-on link; REST above is the fallback). The door logs in
// as "door" with DEVICE_API_KEY. Prod: port 8883, dev: 8884, host = VPS IP
// (the czeros.tech names go through Cloudflare, which doesn't carry MQTT).
#define MQTT_HOST "103.20.240.48"
#define MQTT_PORT 8883
