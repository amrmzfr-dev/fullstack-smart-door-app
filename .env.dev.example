# Lives on the VPS as /opt/smart-door-dev/.env.dev (never committed).

POSTGRES_DB=smartdoor_dev
POSTGRES_USER=smartdoor
POSTGRES_PASSWORD=change-me

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=smartdoor_dev;Username=smartdoor;Password=change-me
Redis__ConnectionString=redis:6379
# Production on purpose: "Development" would also load appsettings.Development.json
# (local-only admin/admin123 login).
ASPNETCORE_ENVIRONMENT=Production

# The web app's address — allowed to call the API.
Cors__AllowedOrigins__0=https://utils-dev.czeros.tech

# Phone fingerprint unlock: the web app's host name (no https://, no port)
# and its full address.
WebAuthn__RpId=utils-dev.czeros.tech
WebAuthn__Origins__0=https://utils-dev.czeros.tech

# Long random string (e.g. `openssl rand -base64 48`) — signs login JWTs.
Jwt__Key=change-me-to-a-long-random-string

# Shared secret the door controller sends as X-Device-Key.
Device__ApiKey=change-me-to-a-long-random-string

# Admin logins to create on startup (skipped if the username exists).
SeedUsers__0__Username=change-me
SeedUsers__0__Password=change-me
